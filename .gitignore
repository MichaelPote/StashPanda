# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
/bundle
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Output of a `tsc -b` or `vue-tsc -b` run (tsconfig.node.json is composite). Vite looks for
# vite.config.js before vite.config.ts, so a compiled copy would hide edits to the real config.
*.tsbuildinfo
/vite.config.js
/vite.config.d.ts

# Git worktrees that Claude Code creates for its background agents.
/.claude/worktrees/

# Photoshop source files for artwork such as the app icon. Only the exported PNGs are committed.
*.psd

# Local settings for the scripts in scripts/, such as the Windows mirror folder. See .env.example.
.env

# Mobile icon sets that `npm run icons` (tauri icon) also writes; StashPanda is desktop only.
/src-tauri/icons/android/
/src-tauri/icons/ios/
