{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StashPanda",
  "version": "0.6.5",
  "identifier": "com.mikepote.stashpanda",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StashPanda",
        "width": 1400,
        "height": 900,
        "theme": "Dark",
        "backgroundColor": "#191b1e",
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-component-update"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Michael Pote",
    "copyright": "Copyright (C) 2026",
    "shortDescription": "A standalone desktop Git GUI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4M0ExRDgzMjI0MEJBMTEKUldRUnVrQWlneDA2NlBnVU82bG5oVWUzT3B0aHYzdUNDb05VWTl5Y3A1dTM2ZWo1cTZKMld2alQK",
      "endpoints": [
        "https://github.com/MichaelPote/StashPanda/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
