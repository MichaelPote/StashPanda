# Copy this file to .env and fill it in. Git ignores .env.
# scripts/windows.sh and scripts/testbed-remotes.sh read it literally, so backslashes in a Windows
# path stay as typed. A variable already set in the environment wins over the file.

# The Windows folder that scripts/windows.sh (npm run win:ux, win:dev, win:build and win:sync)
# mirrors the source to and builds in.
STASHPANDA_WIN_DIR=C:\src\stashpanda

# Where `scripts/testbed-remotes.sh windows` makes its clones, as a Git Bash path. Defaults to
# ~/stashpanda-testbeds in the Windows home folder.
# TESTBED_WIN_CLONE_DIR=/c/src/stashpanda-testbeds
